{
  "name": "@insitetechjp/dssrf",
  "version": "2.0.0",
  "description": "SSRF defense library for Node.js with safe URL validation and pinned fetching.",
  "keywords": [
    "ssrf",
    "safe-http",
    "secure-url",
    "nodejs",
    "web-security"
  ],
  "homepage": "https://github.com/HackingRepo/dssrf-js#readme",
  "bugs": {
    "url": "https://github.com/HackingRepo/dssrf-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HackingRepo/dssrf-js.git"
  },
  "license": "MIT",
  "author": "RelunSec",
  "type": "commonjs",
  "main": "dist/utils.js",
  "types": "dist/utils.d.ts",
  "exports": {
    ".": {
      "types": "./dist/utils.d.ts",
      "require": "./dist/utils.js",
      "import": "./dist/utils.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "ipaddr.js": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
